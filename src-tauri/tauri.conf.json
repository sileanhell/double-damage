{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "double-damage",
  "mainBinaryName": "dd",
  "version": "0.1.0",
  "identifier": "md.usm.double-damage",
  "build": {
    "beforeDevCommand": "cargo build -p dd-core && bun run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
